# Minimal context for the build: everything stays out, except what the build needs.
# (Avoids sending node_modules, dist, art generation caches and local files to the daemon.)
*
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!client/
!shared/
!server/
!scripts/build-server.mjs
!scripts/build-info.mjs

# Even inside the included folders: no local junk.
**/node_modules
**/.DS_Store
**/*.log
